# ============================================================
# TDWM MCP Server - Environment Configuration
# ============================================================

# --- Database Connection ---
# Connection URL (required)
DATABASE_URI=teradata://username:password@hostname/database

# Authentication mechanism: TD2 (default), LDAP, KRB5, TDNEGO, JWT
DB_LOGMECH=TD2

# Extra auth data (for LDAP/JWT)
# LDAP example: DB_LOGDATA="authcid=user@domain.com password=ldap_password"
# JWT example:  DB_LOGDATA="authcid=token_issuer password=jwt_token_string"
DB_LOGDATA=

# TLS/SSL mode: ALLOW, PREFER, REQUIRE, VERIFY-CA, VERIFY-FULL
DB_SSL_MODE=

# Transport encryption (true/false)
DB_ENCRYPT_DATA=true

# --- Connection Resilience ---
DB_MAX_RETRIES=3
DB_INITIAL_BACKOFF=1.0
DB_MAX_BACKOFF=30.0

# --- MCP Transport ---
# Transport: stdio (default), sse, streamable-http
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp/

# --- CORS ---
# Allowed origins for CORS (comma-separated or * for all)
CORS_ALLOWED_ORIGINS=*

# --- OAuth 2.1 (Optional) ---
OAUTH_ENABLED=false
KEYCLOAK_URL=https://your-keycloak-server.com
KEYCLOAK_REALM=teradata-realm
KEYCLOAK_CLIENT_ID=tdwm-mcp
KEYCLOAK_CLIENT_SECRET=your-secret
OAUTH_RESOURCE_SERVER_URL=https://your-mcp-server.com
OAUTH_REQUIRED_SCOPES=tdwm:read,tdwm:query
OAUTH_VALIDATE_AUDIENCE=true
OAUTH_VALIDATE_SCOPES=true
OAUTH_REQUIRE_HTTPS=true

# --- Tool Retry ---
TOOL_MAX_RETRIES=2
TOOL_RETRY_INITIAL_DELAY=0.5
TOOL_MAX_RETRY_DELAY=2.0

# --- Logging ---
LOG_LEVEL=INFO
